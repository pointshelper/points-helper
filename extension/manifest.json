{
  "manifest_version": 3,
  "name": "Points Helper for Aeroplan",
  "short_name": "Points Helper",
  "version": "0.1.4",
  "description": "Check that your Aeroplan eStore points will track at Amazon.ca, Walmart.ca and more.",
  "permissions": ["cookies", "storage", "favicon", "scripting", "activeTab", "declarativeContent"],
  "host_permissions": [
    "https://*.amazon.ca/*",
    "https://*.walmart.ca/*"
  ],
  "optional_host_permissions": [
    "https://*.uniqlo.com/*",
    "https://*.bestbuy.ca/*",
    "https://*.decathlon.ca/*",
    "https://*.marriott.com/*",
    "https://*.lego.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.amazon.ca/*", "https://*.walmart.ca/*"],
      "js": ["stores.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Points Helper",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16-off.png",
      "32": "icons/icon32-off.png"
    }
  }
}
